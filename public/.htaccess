Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /lam-shaml/public/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ index.php?path=$1 [QSA,L]
</IfModule>

<FilesMatch "^(\.env|.*\.sql|.*\.log|.*\.bak|.*\.backup|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
